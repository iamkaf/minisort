{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/iamkaf/minisort"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.iamkaf.minisort.fabric.FabricEntrypoint"
    ],
    "client": [
      "com.iamkaf.minisort.fabric.FabricClientEntrypoint"
    ],
    "jei_mod_plugin": [
      "com.iamkaf.minisort.compat.jei.MiniSortJeiPlugin"
    ],
    "rei_client": [
      "com.iamkaf.minisort.compat.rei.MiniSortReiPlugin"
    ],
    "controlify": [
      "com.iamkaf.minisort.compat.controlify.MiniSortControlify"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "amber": ">=${amber_version}",
    "konfig": ">=${konfig_version}",
    "minecraft": "${fabric_version_range}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "modmenu": ">=${mod_menu_version}"
  },
  "breaks": {
    "controlify": "<3.0.0"
  }
}
